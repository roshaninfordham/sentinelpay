{
  "name": "payfirewall-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the PayFirewall requester tools (verify_payment, get_verification, block_payment).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "payfirewall-mcp": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "payfirewall-mcp": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --clean --out-dir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "payfirewall": "workspace:*"
  }
}
