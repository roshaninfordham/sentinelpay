{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "payfirewall": [
        "./packages/engine/src/index.ts"
      ],
      "payfirewall/tools": [
        "./packages/engine/src/tools/index.ts"
      ],
      "payfirewall/http": [
        "./packages/engine/src/http/index.ts"
      ],
      "payfirewall/client": [
        "./packages/engine/src/http/client.ts"
      ],
      "payfirewall/testing": [
        "./packages/engine/src/testing/index.ts"
      ],
      "payfirewall/adapters/memory": [
        "./packages/engine/src/adapters/memory.ts"
      ],
      "payfirewall/adapters/libsql": [
        "./packages/engine/src/adapters/libsql.ts"
      ],
      "payfirewall/adapters/rdap": [
        "./packages/engine/src/adapters/rdap.ts"
      ],
      "payfirewall/adapters/tavily": [
        "./packages/engine/src/adapters/tavily.ts"
      ],
      "payfirewall/adapters/fixtures": [
        "./packages/engine/src/adapters/fixtures.ts"
      ],
      "payfirewall/adapters/column": [
        "./packages/engine/src/adapters/column.ts"
      ],
      "payfirewall/adapters/elevenlabs": [
        "./packages/engine/src/adapters/elevenlabs.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
