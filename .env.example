# ── SentinelPay environment ─────────────────────────────────────────────
# Copy to .env.local. With the defaults below the full demo runs offline with zero keys.
# Only src/lib/engine.ts and src/lib/db.ts read these; the payfirewall packages never read the environment.

# "cache" = fixtures only (wifi-off safe). "live" = real APIs, fixture fallback per call.
DEMO_MODE=cache

# Delay between investigation-terminal lines, in ms (so an audience can follow)
DEMO_PACE_MS=900

# Company the voice agent and approval links say they act for
PAYER_COMPANY_NAME=Acme Corp

# ── Database (libSQL) ──
# Unset: a local SQLite file, sentinel.db in the project root. On Vercel, set TURSO_* (serverless instances share no disk).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local file path override (default ./sentinel.db). Leave commented unless you need it: an empty value is not a default.
# SENTINEL_DB_PATH=./sentinel.db

# ── PayFirewall engine ──
# "sandbox" (default, the public demo), "test", or "production". Production refuses unsafe config:
# no token pepper, APPROVAL_DELIVERY=log, test challengers, fixture data clearing payments.
SENTINELPAY_ENVIRONMENT=sandbox
# Pepper for responder-token hashes, at least 32 bytes (e.g. `openssl rand -base64 48`). Required in production;
# sandbox falls back to a derived development pepper with a warning. Changing it invalidates open approval links.
SENTINELPAY_TOKEN_PEPPER=
# API keys for /api/v1 (agents, payfirewall-mcp remote mode). Comma-separated key:kind:id:role entries.
#   kind = agent | human | system
#   role = requester | operator (both: requester+operator)
# Example: sk_ap_bot_7f3c:agent:ap-bot:requester,sk_jdoe_91ab:human:jdoe:operator
# The key before the first ":" is the bearer secret; the id is who the ledger records. In production the
# dashboard's routes (/api/release, /api/webhook, /api/block, /api/stream, /api/voice/token, /api/governor/decide,
# /api/investigate, /api/incident/*) require an operator key, and the dashboard page itself is not served.
SENTINELPAY_API_KEYS=
# Human approval challenger. "log" prints the approval link (with its responder token) to the server log:
# sandbox and test only, refused in production because the requester may be able to read the log.
# Leave empty to challenge by browser voice call only.
APPROVAL_DELIVERY=
# Base URL of the /approve page in delivered links (default: https://$VERCEL_URL/approve, else http://localhost:3000/approve)
APPROVAL_BASE_URL=

# ── Payment rail ──
# "mock"   = local AP queue, no rail: PayFirewall decides, nothing is sent (default)
# "column" = Column bank sandbox: beneficiaries read from counterparties, releases create sandbox wires.
#            Requires DEMO_MODE=live, COLUMN_API_KEY, and `pnpm column:setup`.
PAYMENT_SOURCE=mock

# ── Column sandbox ── https://dashboard.column.com (free, self-serve). Sandbox keys only (test_...).
COLUMN_API_KEY=
# Optional: entity to own the AP bank account (defaults to the first entity in your sandbox)
COLUMN_ENTITY_ID=
# One-line JSON printed by `pnpm column:setup`. Use on Vercel, where there is no local .column-sandbox.json.
COLUMN_SANDBOX_CONFIG=
# Optional path to the setup file (default ./.column-sandbox.json). Leave commented unless you need it.
# COLUMN_CONFIG_PATH=./.column-sandbox.json

# ── Tavily (corporate OSINT) ── https://tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=

# ── ElevenLabs (browser voice challenge) ── https://elevenlabs.io
# Configure the agent from src/lib/voice/agent.config.md
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── OpenSanctions (planned: beneficiary screening, not read yet) ── https://opensanctions.org
OPENSANCTIONS_API_KEY=
